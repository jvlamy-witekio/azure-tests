{
  "name": "azure-tests",
  "version": "1.0.0",
  "description": "",
  "main": "dist/functions/index.js",
  "scripts": {
    "preinstall": "npm i --prefix src/functions",
    "build": "cd src/functions && npm run build",
    "start": "cd src/functions && npm run start",
    "watch": "cd src/functions && npm run watch",
    "dev": "npm-run-all --parallel watch start",
    "docker:up": "docker compose up --build --remove-orphans",
    "docker:down": "docker compose down"
  },
  "dependencies": {},
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.0"
  }
}