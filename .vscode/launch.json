{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Start All & Debug",
      "configurations": [
        "Debug api & functions",
        "Debug angular",
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "default",
        "order": 1
      }
    }
  ],
  "configurations": [
    {
      "name": "Debug api & functions",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "docker-up",
      "postDebugTask": "docker-down"
    },
    {
      "name": "Debug angular",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "angular-start",
      "postDebugTask": "angular-stop",
      "url": "http://localhost:4200/"
    },
  ]
}